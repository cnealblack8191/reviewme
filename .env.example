DATABASE_URL="postgresql://postgres:postgres@localhost:5432/reviewme"
SESSION_SECRET="replace-with-a-long-random-string"
COOKIE_SECURE="true"
APP_BASE_URL="https://reviewme.ecinc.us"

# First admin account created by `npm run db:seed`
SEED_ADMIN_NAME="Charles Black"
SEED_ADMIN_EMAIL="charles@ecinc.us"
SEED_ADMIN_PASSWORD=""
# When set, the seed also creates demo office and foreman accounts with this password
SEED_DEMO_PASSWORD=""

# ECI Central sign-in for office staff (docs/CENTRAL_LOGIN.md). Leave URL empty to hide the button.
# Central redirects to {APP_BASE_URL}/auth/central?token=<JWT>. Give either the HS256 shared secret or the RS256 public key.
CENTRAL_LOGIN_URL=""
CENTRAL_LOGIN_ISSUER="central.ecinc.us"
CENTRAL_LOGIN_SECRET=""
CENTRAL_LOGIN_PUBLIC_KEY=""
# "true" once every office user has a central account: office-only accounts then cannot use a password.
CENTRAL_LOGIN_REQUIRED="false"

# Azure AI Translator for typed text, fallback for values entered on the Settings page. docs/TRANSLATION.md
AZURE_TRANSLATOR_KEY=""
AZURE_TRANSLATOR_REGION=""
AZURE_TRANSLATOR_ENDPOINT=""

# Shared secret for the daily reminder job: `npm run reminders:run` posts to /api/cron/reminders with it.
CRON_SECRET=""

# Optional key for encrypting credentials saved on the Settings page. Falls back to SESSION_SECRET.
APP_ENCRYPTION_KEY=""

# Twilio, texts to workers. Prefer entering these on the admin Settings page; these are the fallback.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# Microsoft 365 email through Graph, application permission Mail.Send. Prefer entering these on the admin Settings page.
# Client secret or certificate paths. Steps in docs/MS365_EMAIL.md. Leave empty and the app logs instead of sending.
MICROSOFT_GRAPH_TENANT_ID=""
MICROSOFT_GRAPH_CLIENT_ID=""
MICROSOFT_GRAPH_SENDER="reviews@ecinc.us"
MICROSOFT_GRAPH_CLIENT_SECRET=""
MICROSOFT_GRAPH_CERTIFICATE_PATH=""
MICROSOFT_GRAPH_PRIVATE_KEY_PATH=""
