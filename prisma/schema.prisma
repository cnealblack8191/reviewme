generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- People and access ----------

/// FOREMAN, PROJECT_MANAGER and SENIOR_MANAGER are reviewer roles: they complete
/// reviews for the employees assigned to them and work from the phone home.
/// OFFICE runs periods, approvals, exports, notes and the pay block. ADMIN adds users.
enum Role {
  FOREMAN
  PROJECT_MANAGER
  SENIOR_MANAGER
  OFFICE
  ADMIN
}

enum Language {
  EN
  ES
}

enum IdentityCheck {
  PHONE_LAST4
  SSN_LAST4
}

/// One row, id "eci". Company-wide switches. A tenant column comes later.
model CompanySettings {
  id                     String        @id @default("eci")
  name                   String        @default("Electrical Contractor Inc.")
  shortName              String        @default("ECI")
  identityCheck          IdentityCheck @default(PHONE_LAST4)
  linkTtlDays            Int           @default(7)
  linkMaxAttempts        Int           @default(3)
  remindersEnabled       Boolean       @default(true)
  reminderEmployeeDays   Int           @default(3)
  reminderSupervisorDays Int           @default(7)
  smsEnabled             Boolean       @default(false)
  emailEnabled           Boolean       @default(true)
  /// IANA zone used for reminder quiet hours (texts only between 8 a.m. and 9 p.m.).
  timezone               String        @default("America/New_York")
  reminderQuietStartHour Int           @default(8)
  reminderQuietEndHour   Int           @default(21)

  // Messaging credentials entered on the admin Settings page. Secrets are
  // AES-256-GCM ciphertext (lib/secrets.ts). Environment variables are the fallback.
  twilioAccountSid       String?
  twilioAuthTokenEnc     String?
  twilioFromNumber       String?
  graphTenantId          String?
  graphClientId          String?
  graphSender            String?
  graphClientSecretEnc   String?
  graphCertificatePemEnc String?
  graphPrivateKeyPemEnc  String?

  // Azure AI Translator for typed text (answers, comments, goals). Fixed form text is stored bilingual already.
  translationEnabled Boolean @default(true)
  translatorKeyEnc   String?
  translatorRegion   String?
  translatorEndpoint String?

  updatedAt DateTime @updatedAt
}

model User {
  id                 String   @id @default(cuid())
  email              String   @unique
  name               String
  passwordHash       String
  /// Set when an admin issues a temporary password; the next sign-in must change it.
  mustChangePassword Boolean  @default(false)
  /// Screen language for reviewers on the phone. The office desktop stays English.
  language           Language @default(EN)
  roles              Role[]
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  employee            Employee?
  reviewsAsSupervisor Review[]     @relation("ReviewSupervisor")
  approvedReviews     Review[]     @relation("ReviewApprover")
  employeesReviewed   Employee[]   @relation("EmployeeReviewer")
  officeNotes         OfficeNote[]
  auditEvents         AuditEvent[]
  payBlockUpdates     PayBlock[]
  linksCreated        ReviewLink[]
}

/// Anyone who receives a review. A foreman is an Employee too, reviewed by a manager.
model Employee {
  id           String    @id @default(cuid())
  firstName    String
  lastName     String
  phone        String?
  phoneLast4   String?
  /// scrypt hash of the last 4 of the SSN, only when identityCheck = SSN_LAST4. Never stored in clear.
  ssnLast4Hash String?
  email        String?
  position     String
  iecStatus    String?
  hireDate     DateTime?
  jobSite      String?
  language     Language  @default(EN)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  templateId String
  template   ReviewTemplate @relation(fields: [templateId], references: [id])
  reviewerId String
  reviewer   User           @relation("EmployeeReviewer", fields: [reviewerId], references: [id])
  /// Set when the employee also signs in, for example a foreman.
  userId     String?        @unique
  user       User?          @relation(fields: [userId], references: [id])

  reviews  Review[]
  messages MessageLog[]
}

// ---------- Forms as data ----------

model ReviewTemplate {
  id        String  @id @default(cuid())
  key       String  @unique
  titleEn   String
  titleEs   String
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  criteria  TemplateCriterion[]
  questions TemplateQuestion[]
  employees Employee[]
  reviews   Review[]
}

model TemplateCriterion {
  id         String         @id @default(cuid())
  templateId String
  template   ReviewTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  sortOrder  Int
  labelEn    String
  labelEs    String

  answers ReviewAnswer[]

  @@unique([templateId, sortOrder])
}

model TemplateQuestion {
  id         String         @id @default(cuid())
  templateId String
  template   ReviewTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  sortOrder  Int
  key        String
  textEn     String
  textEs     String

  answers ReviewQuestionAnswer[]

  @@unique([templateId, sortOrder])
}

// ---------- Reviews ----------

model ReviewPeriod {
  id        String    @id @default(cuid())
  name      String
  opensAt   DateTime  @default(now())
  dueDate   DateTime
  closedAt  DateTime?
  createdAt DateTime  @default(now())

  reviews Review[]
}

enum SideStatus {
  NOT_STARTED
  IN_PROGRESS
  SUBMITTED
}

/// Overall state of one review. Supervisor and employee sides progress independently
/// (see supervisorStatus / employeeStatus) until both are SUBMITTED, then the office takes over.
enum ReviewStatus {
  OPEN
  PENDING_OFFICE
  SENT_BACK
  APPROVED
  DISCUSSED
  SIGN_LINK_SENT
  SIGNED
  DECLINED
  CLOSED
}

model Review {
  id       String       @id @default(cuid())
  periodId String
  period   ReviewPeriod @relation(fields: [periodId], references: [id])

  employeeId   String
  employee     Employee       @relation(fields: [employeeId], references: [id])
  supervisorId String
  supervisor   User           @relation("ReviewSupervisor", fields: [supervisorId], references: [id])
  /// Template snapshot: the employee's template when the review was created.
  templateId   String
  template     ReviewTemplate @relation(fields: [templateId], references: [id])
  language     Language       @default(EN)

  status           ReviewStatus @default(OPEN)
  supervisorStatus SideStatus   @default(NOT_STARTED)
  employeeStatus   SideStatus   @default(NOT_STARTED)

  overallRating    Int?
  overallComments  String?
  goals            String?
  employeeComments String?

  supervisorSubmittedAt DateTime?
  employeeSubmittedAt   DateTime?
  approvedAt            DateTime?
  approvedById          String?
  approvedBy            User?     @relation("ReviewApprover", fields: [approvedById], references: [id])
  sentBackReason        String?
  sentBackAt            DateTime?
  discussedAt           DateTime?
  signedAt              DateTime?
  declinedAt            DateTime?
  closedAt              DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  answers         ReviewAnswer[]
  questionAnswers ReviewQuestionAnswer[]
  links           ReviewLink[]
  notes           OfficeNote[]
  payBlock        PayBlock?
  signature       Signature?
  events          AuditEvent[]
  messages        MessageLog[]

  @@unique([periodId, employeeId])
  @@index([supervisorId, status])
}

enum AnswerSide {
  EMPLOYEE
  SUPERVISOR
}

model ReviewAnswer {
  id          String            @id @default(cuid())
  reviewId    String
  review      Review            @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  criterionId String
  criterion   TemplateCriterion @relation(fields: [criterionId], references: [id])
  side        AnswerSide
  /// 1 to 4
  rating      Int?
  comment     String?
  updatedAt   DateTime          @updatedAt

  @@unique([reviewId, criterionId, side])
}

model ReviewQuestionAnswer {
  id         String           @id @default(cuid())
  reviewId   String
  review     Review           @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  questionId String
  question   TemplateQuestion @relation(fields: [questionId], references: [id])
  answer     String
  updatedAt  DateTime         @updatedAt

  @@unique([reviewId, questionId])
}

// ---------- Worker links ----------

enum LinkKind {
  SELF_EVAL
  SIGN
}

enum MessageChannel {
  SMS
  EMAIL
  HANDOFF
  /// Link created for the office to copy and send by hand (their own phone, in person).
  MANUAL
}

model ReviewLink {
  id              String         @id @default(cuid())
  reviewId        String
  review          Review         @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  kind            LinkKind
  /// sha256 of the raw token, used to look a link up.
  tokenHash       String         @unique
  /// The raw token encrypted with a key derived from SESSION_SECRET, so a
  /// reminder can resend the same link without minting a new one.
  tokenCiphertext String?
  channel         MessageChannel
  sentTo          String?
  expiresAt       DateTime
  openedAt        DateTime?
  verifiedAt      DateTime?
  usedAt          DateTime?
  voidedAt        DateTime?
  attempts        Int            @default(0)
  lockedAt        DateTime?
  createdById     String?
  createdBy       User?          @relation(fields: [createdById], references: [id])
  createdAt       DateTime       @default(now())

  @@index([reviewId, kind])
}

model Signature {
  id             String   @id @default(cuid())
  reviewId       String   @unique
  review         Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  typedName      String
  /// PNG data URL drawn on the phone. Null when declined.
  imageData      String?
  declined       Boolean  @default(false)
  declineComment String?
  signedAt       DateTime @default(now())
  ipAddress      String?
  userAgent      String?
}

// ---------- Office only ----------

model OfficeNote {
  id        String   @id @default(cuid())
  reviewId  String
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  body      String
  createdAt DateTime @default(now())
}

/// Current status and recommendations from page 2 of the paper form. Office only.
model PayBlock {
  id              String    @id @default(cuid())
  reviewId        String    @unique
  review          Review    @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  currentPayRate  Decimal?  @db.Decimal(10, 2)
  lastReviewDate  DateTime?
  lastRaiseDate   DateTime?
  lastRaiseAmount Decimal?  @db.Decimal(10, 2)
  raiseAmount     Decimal?  @db.Decimal(10, 2)
  newPayRate      Decimal?  @db.Decimal(10, 2)
  dateEffective   DateTime?
  nextReviewDate  DateTime?
  updatedById     String
  updatedBy       User      @relation(fields: [updatedById], references: [id])
  updatedAt       DateTime  @updatedAt
}

/// Machine translations of typed text, cached so a sentence is translated once. lib/translate.ts
model Translation {
  id             String   @id @default(cuid())
  /// sha256 of `${from}|${to}|${text}`
  key            String   @unique
  sourceLang     String
  targetLang     String
  sourceText     String
  translatedText String
  provider       String
  createdAt      DateTime @default(now())
}

/// Failed sign-in counter per email and per address. lib/throttle.ts
model LoginThrottle {
  key            String    @id
  failures       Int       @default(0)
  firstFailureAt DateTime  @default(now())
  lockedUntil    DateTime?
  updatedAt      DateTime  @updatedAt
}

/// One-time login tokens from central.ecinc.us that have already been used (replay protection).
model ConsumedLoginToken {
  jti       String   @id
  expiresAt DateTime
  usedAt    DateTime @default(now())

  @@index([expiresAt])
}

// ---------- Audit and messaging ----------

model AuditEvent {
  id          String   @id @default(cuid())
  reviewId    String?
  review      Review?  @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  actorUserId String?
  actor       User?    @relation(fields: [actorUserId], references: [id])
  /// "worker" for link actions with no signed-in user
  actorLabel  String
  action      String
  field       String?
  oldValue    String?
  newValue    String?
  createdAt   DateTime @default(now())

  @@index([reviewId, createdAt])
}

model MessageLog {
  id         String         @id @default(cuid())
  reviewId   String?
  review     Review?        @relation(fields: [reviewId], references: [id], onDelete: SetNull)
  employeeId String?
  employee   Employee?      @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  channel    MessageChannel
  to         String
  purpose    String
  providerId String?
  status     String
  error      String?
  createdAt  DateTime       @default(now())
}
